{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "audit": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "NameserverCount"
          ],
          "additionalProperties": false,
          "properties": {
            "NameserverCount": {
              "type": "object",
              "required": [],
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "description": "Logical source path. Defaults to /etc/resolv.conf.",
                  "pattern": "(^\\$[a-zA-Z0-9_]+:(/.*)$|(^/.*$))"
                }
              }
            }
          }
        }
      ]
    },
    "remediation": {
      "anyOf": []
    }
  }
}
