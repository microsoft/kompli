{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "audit": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "MtaLocalOnly"
          ],
          "additionalProperties": false,
          "properties": {
            "MtaLocalOnly": {
              "type": "object",
              "required": [],
              "additionalProperties": false,
              "properties": {
                "configurationVersion": {
                  "type": "string",
                  "description": "Configuration check version from the source audit; none checks only listening ports",
                  "pattern": "(^\\$[a-zA-Z0-9_]+:((none|1|2|3))$|(^(none|1|2|3)$))"
                }
              }
            }
          }
        }
      ]
    },
    "remediation": {
      "anyOf": []
    }
  }
}
