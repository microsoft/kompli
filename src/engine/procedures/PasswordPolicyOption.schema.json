{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "audit": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "PasswordPolicyOption"
          ],
          "additionalProperties": false,
          "properties": {
            "PasswordPolicyOption": {
              "type": "object",
              "required": [
                "policy",
                "option",
                "value"
              ],
              "additionalProperties": false,
              "properties": {
                "policy": {
                  "type": "string",
                  "description": "PAM policy family; managed integration uses effective inline arguments where the module does not read a policy file.",
                  "pattern": "(^\\$[a-zA-Z0-9_]+:((pwquality|faillock|pwhistory))$|(^(pwquality|faillock|pwhistory)$))"
                },
                "option": {
                  "type": "string",
                  "description": "Allowlisted numeric or boolean option."
                },
                "value": {
                  "type": "string",
                  "description": "Explicit integer target, or \"true\" for a boolean flag; managed integration retains stronger existing settings."
                },
                "integratePam": {
                  "type": "string",
                  "description": "Opt in to provider-preserving vendor PAM integration and policy database lifecycle.",
                  "pattern": "(^\\$[a-zA-Z0-9_]+:((true|false))$|(^(true|false)$))"
                }
              }
            }
          }
        }
      ]
    },
    "remediation": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "PasswordPolicyOption"
          ],
          "additionalProperties": false,
          "properties": {
            "PasswordPolicyOption": {
              "type": "object",
              "required": [
                "policy",
                "option",
                "value"
              ],
              "additionalProperties": false,
              "properties": {
                "policy": {
                  "type": "string",
                  "description": "PAM policy family; managed integration uses effective inline arguments where the module does not read a policy file.",
                  "pattern": "(^\\$[a-zA-Z0-9_]+:((pwquality|faillock|pwhistory))$|(^(pwquality|faillock|pwhistory)$))"
                },
                "option": {
                  "type": "string",
                  "description": "Allowlisted numeric or boolean option."
                },
                "value": {
                  "type": "string",
                  "description": "Explicit integer target, or \"true\" for a boolean flag; managed integration retains stronger existing settings."
                },
                "integratePam": {
                  "type": "string",
                  "description": "Opt in to provider-preserving vendor PAM integration and policy database lifecycle.",
                  "pattern": "(^\\$[a-zA-Z0-9_]+:((true|false))$|(^(true|false)$))"
                }
              }
            }
          }
        }
      ]
    }
  }
}
