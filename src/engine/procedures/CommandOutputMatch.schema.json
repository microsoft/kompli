{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "audit": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "CommandOutputMatch"
          ],
          "additionalProperties": false,
          "properties": {
            "CommandOutputMatch": {
              "type": "object",
              "required": [
                "command",
                "pattern"
              ],
              "additionalProperties": false,
              "properties": {
                "command": {
                  "type": "string",
                  "description": "Exact allowlisted command to execute; apt-config dump reads effective APT configuration without modifying it"
                },
                "awk": {
                  "type": "string",
                  "description": "Optional GNU awk transformation, executed in sandbox mode (-S)"
                },
                "pattern": {
                  "type": "string",
                  "description": "Regex to be matched"
                },
                "type": {
                  "type": "string",
                  "description": "Type of regex, P for Perl (default) or E for Extended"
                }
              }
            }
          }
        }
      ]
    },
    "remediation": {
      "anyOf": []
    }
  }
}
