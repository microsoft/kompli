{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Unified benchmark-definition file",
  "description": "One native definition file per benchmark, as a Kubernetes-style resource (apiVersion / kind / metadata / spec) consistent with the other compliancectl data files. Carries identity + inline rule payloads + generic metadata + flat axis:value tags. Produced by the Compliance Augmentation Engine and consumed by kompli as its input (replacing the MOF, which is retained only for Machine Configuration).",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "allOf": [
    {
      "anyOf": [
        {
          "properties": {
            "metadata": {
              "required": ["labels", "annotations"]
            }
          }
        },
        {
          "properties": {
            "spec": {
              "properties": {
                "rules": {
                  "minItems": 1,
                  "items": {
                    "required": ["section", "payloadKey"],
                    "not": {
                      "required": ["id"]
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  ],
  "properties": {
    "apiVersion": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]*$",
      "description": "API version string, e.g. 'v1'. Versions the file format, independently of the benchmark's own version."
    },
    "kind": {
      "type": "string",
      "const": "BenchmarkDefinition",
      "description": "Resource kind."
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "name"
      ],
      "oneOf": [
        {
          "required": ["labels", "annotations"]
        },
        {
          "not": {
            "anyOf": [
              { "required": ["labels"] },
              { "required": ["annotations"] }
            ]
          }
        }
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]*$",
          "description": "Stable benchmark identifier (the benchmark selector label)."
        },
        "labels": {
          "type": "object",
          "description": "Selectable identity axes. Required for sole-id definitions; legacy definitions may derive the same identity from their payload keys.",
          "required": ["framework", "distribution", "distributionVersion"],
          "properties": {
            "framework": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\u0000]*$",
              "description": "Required opaque benchmark framework identity. It does not select parsing or execution behavior."
            },
            "distribution": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\u0000]*$"
            },
            "distributionVersion": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\u0000]*$"
            }
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "annotations": {
          "type": "object",
          "description": "Non-selectable descriptive fields.",
          "required": ["benchmarkVersion"],
          "properties": {
            "benchmarkVersion": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\u0000]*$"
            }
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "rules"
      ],
      "properties": {
        "rules": {
          "type": "array",
          "description": "One entry per rule in the selected benchmark.",
          "items": {
            "$ref": "#/definitions/rule"
          }
        }
      }
    }
  },
  "definitions": {
    "rule": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "ruleName",
        "title",
        "ruleId",
        "tags",
        "metadata",
        "payload"
      ],
      "oneOf": [
        {
          "required": ["section", "payloadKey"],
          "not": {
            "required": ["id"]
          }
        },
        {
          "required": ["id"],
          "not": {
            "anyOf": [
              { "required": ["section"] },
              { "required": ["payloadKey"] }
            ]
          }
        }
      ],
      "properties": {
        "section": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]*$",
          "description": "Externally-quoted per-rule identifier (dotted CIS number or STIG id). Unique within a benchmark."
        },
        "ruleId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]*$",
          "description": "Stable, benchmark-agnostic rule identifier retained unchanged for external correlation."
        },
        "ruleName": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]*$",
          "description": "PascalCase ComplianceEngine rule name."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]*$",
          "description": "Human-readable rule title (section prefix + rule name)."
        },
        "payloadKey": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]*$",
          "description": "The rule's payload key, e.g. '/cis/ubuntu/22.04/v2.0.0/1/1/1/1'."
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]*$",
          "description": "The rule's externally-quoted, framework-defined identifier, opaque and unique within its benchmark definition."
        },
        "tags": {
          "type": "array",
          "description": "Flat, sparse set of framework-agnostic 'axis:value' tags.",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+:[^\\u0000]+$"
          }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "description",
            "rationale",
            "fixtext",
            "severity",
            "references"
          ],
          "properties": {
            "description": {
              "type": "string",
              "pattern": "^[^\\u0000]*$"
            },
            "rationale": {
              "type": "string",
              "pattern": "^[^\\u0000]*$"
            },
            "fixtext": {
              "type": "string",
              "pattern": "^[^\\u0000]*$"
            },
            "severity": {
              "type": "string",
              "pattern": "^[^\\u0000]*$"
            },
            "references": {
              "type": "string",
              "pattern": "^[^\\u0000]*$"
            }
          }
        },
        "payload": {
          "$ref": "payload.schema.json"
        },
        "parameterMetadata": {
          "type": "object",
          "description": "Per-parameter UI/validation contract for the rule's tunable parameters, keyed by parameter name (mirrors the keys of payload.parameters). Additive to the runtime payload.parameters map, which stays {name: default}.",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "default"
            ],
            "properties": {
              "type": {
                "const": "string",
                "description": "Parameter value type (currently only 'string' is supported)."
              },
              "default": {
                "type": "string",
                "pattern": "^[^\\u0000]*$",
                "description": "Default value applied when the parameter is not overridden."
              },
              "displayName": {
                "type": "string",
                "pattern": "^[^\\u0000]*$",
                "description": "Human-readable parameter name for UI presentation."
              },
              "validationRegex": {
                "type": "string",
                "pattern": "^[^\\u0000]*$",
                "description": "Regular expression the parameter value must match."
              },
              "validationFailedMessage": {
                "type": "string",
                "pattern": "^[^\\u0000]*$",
                "description": "Message shown when validationRegex does not match."
              },
              "mandatory": {
                "type": "boolean",
                "description": "True when the parameter must be explicitly set."
              }
            }
          }
        }
      }
    }
  }
}
