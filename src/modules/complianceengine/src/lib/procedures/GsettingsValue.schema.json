{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "audit": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "GsettingsValue"
          ],
          "additionalProperties": false,
          "properties": {
            "GsettingsValue": {
              "type": "object",
              "required": [
                "schema",
                "key",
                "keyType",
                "operation",
                "value"
              ],
              "additionalProperties": false,
              "properties": {
                "schema": {
                  "type": "string",
                  "description": "Name of the gsettings schema to get"
                },
                "key": {
                  "type": "string",
                  "description": "Name of gsettings key to get"
                },
                "keyType": {
                  "type": "string",
                  "description": "Type of key, possible options string,number",
                  "pattern": "(^\\$[a-zA-Z0-9_]+:((number|string))$|(^(number|string)$))"
                },
                "operation": {
                  "type": "string",
                  "description": "Type of comparison; pattern match searches the printed GVariant using ECMAScript regex",
                  "pattern": "(^\\$[a-zA-Z0-9_]+:((eq|ne|lt|gt|is-unlocked|pattern match))$|(^(eq|ne|lt|gt|is-unlocked|pattern match)$))"
                },
                "value": {
                  "type": "string",
                  "description": "Value of operation to check according to the operation"
                },
                "profile": {
                  "type": "string",
                  "description": "Optional dconf profile name or absolute path; empty preserves the caller's environment"
                }
              }
            }
          }
        }
      ]
    },
    "remediation": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "GsettingsValue"
          ],
          "additionalProperties": false,
          "properties": {
            "GsettingsValue": {
              "type": "object",
              "required": [
                "schema",
                "key",
                "keyType",
                "operation",
                "value"
              ],
              "additionalProperties": false,
              "properties": {
                "schema": {
                  "type": "string",
                  "description": "Name of the gsettings schema to get"
                },
                "key": {
                  "type": "string",
                  "description": "Name of gsettings key to get"
                },
                "keyType": {
                  "type": "string",
                  "description": "Type of key, possible options string,number",
                  "pattern": "(^\\$[a-zA-Z0-9_]+:((number|string))$|(^(number|string)$))"
                },
                "operation": {
                  "type": "string",
                  "description": "Type of comparison; pattern match searches the printed GVariant using ECMAScript regex",
                  "pattern": "(^\\$[a-zA-Z0-9_]+:((eq|ne|lt|gt|is-unlocked|pattern match))$|(^(eq|ne|lt|gt|is-unlocked|pattern match)$))"
                },
                "value": {
                  "type": "string",
                  "description": "Value of operation to check according to the operation"
                },
                "profile": {
                  "type": "string",
                  "description": "Optional dconf profile name or absolute path; empty preserves the caller's environment"
                }
              }
            }
          }
        }
      ]
    }
  }
}
