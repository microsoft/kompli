#
# PLACEHOLDER: see src/komplid/README.md. One instance of this template unit
# is spawned per connection accepted by komplid.socket (Accept=yes); the
# connection socket is wired to this instance's stdin/stdout.
#
# User=root is deliberate, not left to the implicit default: komplid is the
# sole process that needs root to execute audit/remediate/enforce actions
# against the system. Passthrough clients only need `kompli` group membership
# (see komplid.socket and README.md's "Privilege model" section) - root is
# intentionally not extended to them.

[Unit]
Description=kompli daemon (per-connection instance)
After=komplid.socket
Requires=komplid.socket

[Service]
User=root
ExecStart=/usr/bin/komplid
StandardInput=socket
StandardOutput=socket
StandardError=journal
